---
import { CONTACT } from "@data/constants";

// Numéro WhatsApp configuré (sans caractères spéciaux pour le lien wa.me)
const rawNumber = CONTACT.whatsapp || "33769694764";
const cleanNumber = rawNumber.replace(/[^0-9]/g, "");
const messageText = encodeURIComponent("Bonjour Teranga Trade And Logistics, je souhaite des renseignements sur vos équipements.");
const whatsappUrl = `https://wa.me/${cleanNumber}?text=${messageText}`;
---

<!-- Bouton Flottant WhatsApp Business Circulaire Minimaliste (WCAG 2.1 AA) -->
<aside
  aria-label="Assistance directe WhatsApp"
  class="fixed bottom-5 right-5 sm:bottom-6 sm:right-6 z-40 print:hidden"
>
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contacter Teranga Trade And Logistics sur WhatsApp Business"
    title="Discuter sur WhatsApp"
    class="relative group flex h-14 w-14 sm:h-16 sm:w-16 items-center justify-center rounded-full bg-[#25D366] text-white shadow-[0_8px_25px_rgba(37,211,102,0.4)] hover:shadow-[0_12px_32px_rgba(37,211,102,0.65)] hover:bg-[#20ba59] hover:scale-110 active:scale-95 transition-all duration-300 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-emerald-400 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-neutral-900 border border-white/40"
  >
    <!-- Point indicateur en ligne discret -->
    <span class="absolute top-1 right-1 flex h-3 w-3" aria-hidden="true">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
      <span class="relative inline-flex rounded-full h-3 w-3 bg-white"></span>
    </span>

    <!-- Icône officielle WhatsApp SVG centrée -->
    <svg
      class="h-7 w-7 sm:h-8 sm:w-8 fill-current"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.458L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436 0 9.86-4.37 9.864-9.799.002-2.63-1.023-5.101-2.885-6.968C16.788 2.008 14.321.983 11.758.983 6.321.983 1.895 5.355 1.892 10.785c-.001 1.761.461 3.478 1.337 5.018L2.247 21.9l6.4-1.746zM17.487 14.39c-.3-.15-1.774-.875-2.029-.968-.254-.093-.44-.14-.625.14-.185.28-.716.968-.877 1.154-.162.186-.323.21-.623.06-.3-.15-1.267-.467-2.413-1.49-.893-.797-1.496-1.782-1.672-2.08-.176-.3-.019-.462.13-.61.135-.133.3-.35.45-.525.15-.175.2-.29.3-.485.1-.19.05-.36-.025-.51-.075-.15-.625-1.505-.856-2.06-.225-.54-.473-.465-.648-.475-.166-.01-.357-.01-.548-.01-.19 0-.502.07-.765.357-.263.287-1.003.98-1.003 2.39 0 1.41 1.028 2.77 1.171 2.96.143.19 2.025 3.1 4.904 4.34.685.295 1.22.472 1.637.606.689.219 1.316.188 1.812.114.553-.082 1.774-.725 2.029-1.39.254-.665.254-1.235.179-1.39-.075-.156-.279-.25-.579-.4z"
      />
    </svg>
  </a>
</aside>
