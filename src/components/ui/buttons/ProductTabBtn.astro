---
// Destructure the properties from Astro.props
const { id, dataTab, title, first } = Astro.props;

// Define TypeScript interface for the properties
interface Props {
  id: string;
  dataTab: string;
  title: string;
  first?: boolean;
}
// Define constants for styling classes
const BUTTON_CLASS =
  "flex w-full min-h-[48px] items-center justify-center rounded-xl border border-neutral-200/80 p-3.5 outline-hidden ring-zinc-500 transition duration-300 hover:bg-white/90 focus-visible:ring-3 dark:border-neutral-700/80 dark:ring-zinc-200 dark:hover:bg-neutral-800 dark:focus:outline-hidden md:p-4";

const HEADING_CLASS = "block text-center font-bold text-sm sm:text-base";
const INACTIVE_HEADING_CLASS = "text-neutral-700 dark:text-neutral-300";
---

<!-- Tab button element -->
<button
  type="button"
  class={`${BUTTON_CLASS} ${first ? "active bg-white shadow-xs border-yellow-500/50 dark:bg-neutral-800 dark:border-yellow-400/50" : "bg-white/60 dark:bg-neutral-900/60"}`}
  id={id}
  data-target={dataTab}
  role="tab"
>
  <!-- Tab text -->
  <span
    class={`${HEADING_CLASS} ${first ? "text-yellow-600 dark:text-yellow-400" : INACTIVE_HEADING_CLASS}`}
  >
    {title}
  </span>
</button>
