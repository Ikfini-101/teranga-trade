---
// Teranga Trade and Logistics (TTL) - Solutions & Services
const langProp = Astro.props?.lang;
const raw = (langProp ?? Astro.currentLocale ?? 'fr').toString().toLowerCase();
const lang = raw.startsWith('en') ? 'en' : 'fr';

const t = {
  fr: {
    badge: 'Centrale d\'achat',
    heading: 'Teranga Trade And Logistics',
    sub: 'Opérateur de négoce et centrale d\'achat Europe — Afrique de l\'Ouest',
    intro: "Teranga Trade And Logistics connecte les professionnels ouest-africains aux réseaux d'équipements européens certifiés.",
    imsd: "Contrôle technique, négociation des prix et acheminement maritime sécurisé.",
    tag: 'TTL Europe · TTL Afrique',
  },
  en: {
    badge: 'Purchasing Center',
    heading: 'Teranga Trade And Logistics',
    sub: 'Trading operator & purchasing center Europe — West Africa',
    intro: 'Teranga Trade And Logistics connects West African professionals to certified European equipment networks.',
    imsd: 'Technical inspection, price negotiation, and secured maritime shipping.',
    tag: 'TTL Europe · TTL Africa',
  },
}[lang];
---

<section class="py-12 bg-neutral-100 dark:bg-neutral-900">
  <div class="max-w-5xl mx-auto px-4 text-center">
    <span class="text-xs font-bold uppercase tracking-wider text-yellow-600 dark:text-yellow-400">{t.badge}</span>
    <h2 class="text-3xl font-bold mt-2 text-neutral-800 dark:text-neutral-100">{t.heading}</h2>
    <p class="text-lg text-neutral-600 dark:text-neutral-300 mt-2">{t.sub}</p>
    <p class="mt-4 text-neutral-700 dark:text-neutral-300">{t.intro}</p>
  </div>
</section>
