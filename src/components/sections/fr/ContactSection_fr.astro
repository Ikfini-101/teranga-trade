---
// Import the necessary dependencies.
import ContactIconBlock from "@components/ui/blocks/ContactIconBlock.astro";
import Icon from "@components/ui/icons/Icon.astro";
import ContactForm from "@components/sections/misc/ContactForm.astro";
import { CONTACT } from "@data/constants";

// Define the variables that will be used in this component
const title: string = "Contactez notre centrale d'achat";
const subTitle: string =
  "Prêt à renforcer votre flotte de transport ou à acquérir votre prochain équipement de chantier ou agricole ? Contactez directement notre direction européenne au Havre ou notre équipe à Dakar.";
const formTitle: string = "Demande de cotation ou sourcing";
---

<!-- Contact Us -->
<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div class="mx-auto max-w-2xl lg:max-w-5xl">
    <div class="text-center">
      <h1
        class="text-balance text-2xl font-bold tracking-tight text-neutral-800 dark:text-neutral-200 md:text-4xl md:leading-tight"
      >
        {title}
      </h1>
      <p class="mt-1 text-pretty text-neutral-600 dark:text-neutral-400">
        {subTitle}
      </p>
    </div>

    <div class="mt-12 grid items-center gap-6 lg:grid-cols-2 lg:gap-16">
      <div class="flex flex-col rounded-xl p-4 sm:p-6 lg:p-8">
        <h2
          class="mb-8 text-xl font-bold text-neutral-700 dark:text-neutral-300"
        >
          {formTitle}
        </h2>
        <ContactForm lang="fr" />
      </div>

      <!-- Coordonnées et blocs d'information -->
      <div class="divide-y divide-neutral-300 dark:divide-neutral-700">
        <!-- Siège Europe -->
        <ContactIconBlock
          heading="Siège Europe (Centrale d'achat)"
          content="Teranga Trade And Logistics - Europe (SASU)"
          isAddressVisible={true}
          addressContent="112 rue du Maréchal Joffre, 76600 Le Havre, France"
        >
          <Icon name="mapPin" />
        </ContactIconBlock>

        <!-- Implantation Afrique -->
        <ContactIconBlock
          heading="Implantation Afrique (Exploitation)"
          content="Teranga Trade And Logistics - Africa (SARL)"
          isAddressVisible={true}
          addressContent="Dakar, Sénégal"
        >
          <Icon name="mapPin" />
        </ContactIconBlock>

        <!-- E-mail -->
        <ContactIconBlock
          heading="Contactez-nous par e-mail"
          content="Pour toute demande de cotation, sourcing ou information commerciale :"
          isLinkVisible={true}
          linkTitle={CONTACT.email}
          linkURL={`mailto:${CONTACT.email}`}
        >
          <Icon name="envelopeOpen" />
        </ContactIconBlock>

        <!-- Méthode d'achat -->
        <ContactIconBlock
          heading="Protocole logistique (Incoterm CFR)"
          content="Consultez notre protocole sécurisé en 4 étapes pour vos commandes internationales."
          isLinkVisible={true}
          linkTitle="Voir la méthode d'achat"
          linkURL="/#methode"
          isArrowVisible={true}
        >
          <Icon name="chatBubble" />
        </ContactIconBlock>

        <!-- WhatsApp STRICTEMENT conditionnel -->
        {
          CONTACT.whatsapp ? (
            <ContactIconBlock
              heading="WhatsApp Direction"
              content="Échange direct avec notre direction commerciale :"
              isLinkVisible={true}
              linkTitle="Discuter sur WhatsApp"
              linkURL={`https://wa.me/${CONTACT.whatsapp}`}
              isArrowVisible={true}
            >
              <Icon name="chatBubble" />
            </ContactIconBlock>
          ) : null
        }
      </div>
    </div>
  </div>
</section>
