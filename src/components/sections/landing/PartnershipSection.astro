---
// Teranga Trade and Logistics (TTL) - Partenaires & Réseaux
const { title = "Nos Partenaires Internationaux", subTitle = "Réseau européen de constructeurs et équipementiers" } = Astro.props;
---

<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
  <div class="bg-neutral-50 dark:bg-neutral-800/30 border border-neutral-200 dark:border-neutral-700 rounded-3xl p-8 sm:p-12 transition duration-300 hover:shadow-lg">
    <div class="space-y-4 text-center">
      <div class="inline-block px-4 py-1.5 bg-orange-100 dark:bg-orange-500/10 rounded-full text-orange-600 dark:text-orange-400 text-sm font-semibold tracking-wide uppercase">
        Réseaux d'Approvisionnement
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-neutral-800 dark:text-neutral-200 tracking-tight">
        {title}
      </h2>
      <p class="text-neutral-600 dark:text-neutral-400 text-lg leading-relaxed max-w-2xl mx-auto">
        {subTitle} : Teranga Trade And Logistics s'appuie sur des relations directes avec les concessions et parcs d'équipements vérifiés en Europe pour garantir la conformité technique de chaque matériel expédié.
      </p>
    </div>
  </div>
</section>
