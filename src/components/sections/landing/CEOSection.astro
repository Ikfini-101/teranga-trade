---
// Teranga Trade and Logistics (TTL) - Governance & Leadership
const { title = "Gouvernance & Direction", subTitle = "Teranga Trade And Logistics" } = Astro.props;
---

<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
  <div class="rounded-2xl border border-neutral-200 dark:border-neutral-700 bg-white/70 dark:bg-neutral-800/70 p-8 sm:p-12 shadow-sm">
    <div class="max-w-3xl">
      <h2 class="text-2xl font-bold tracking-tight text-neutral-800 dark:text-neutral-200 sm:text-3xl lg:text-4xl">
        {title}
      </h2>
      <p class="mt-2 text-base text-yellow-600 dark:text-yellow-400 font-semibold">{subTitle}</p>
      <div class="mt-6 border-l-4 border-yellow-500 pl-4">
        <h3 class="text-lg font-bold text-neutral-800 dark:text-neutral-200">Aliou CISSE</h3>
        <p class="text-sm text-neutral-600 dark:text-neutral-400">Président-Fondateur</p>
      </div>
      <p class="mt-4 text-base leading-relaxed text-neutral-700 dark:text-neutral-300">
        Teranga Trade And Logistics assure un pont commercial et logistique rigoureux entre l'Europe et l'Afrique de l'Ouest, avec une centrale d'achat dédiée au Havre et des implantations opérationnelles sur le continent.
      </p>
    </div>
  </div>
</section>
