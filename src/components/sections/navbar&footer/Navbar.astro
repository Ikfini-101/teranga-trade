---
//Import relevant dependencies
import ThemeIcon from "@components/ThemeIcon.astro";
import NavLink from "@components/ui/links/NavLink.astro";
import frStrings from "@utils/navigation.ts";
import BrandLogo from "@components/BrandLogo.astro";

const strings = frStrings;
const homeUrl = "/";
---

<!-- Main header component -->
<header
  class="sticky inset-x-0 top-4 z-50 flex w-full flex-wrap text-sm md:flex-nowrap md:justify-start"
>
  <!-- Navigation container: Pure Crystal Water with Surface Tension Meniscus -->
  <nav
    class="liquid-glass-nav relative mx-2 w-full overflow-hidden rounded-[32px] border border-white/70 bg-white/[0.08] px-4 py-2.5 shadow-[0_12px_36px_rgba(11,37,69,0.06),inset_0_1.5px_2px_0_rgba(255,255,255,0.9),inset_0_-1px_2px_0_rgba(255,255,255,0.25)] transition-colors duration-300 dark:border-white/20 dark:bg-slate-950/[0.22] dark:shadow-[0_12px_36px_rgba(0,0,0,0.45),inset_0_1.5px_2px_0_rgba(255,255,255,0.35),inset_0_-1px_2px_0_rgba(255,255,255,0.08)] md:flex md:items-center md:justify-between md:px-6 md:py-1.5 lg:px-8 xl:mx-auto"
    aria-label="Global"
  >
    <!-- Interactive Water Ripple Surface Canvas (Moves on Mouse Hover) -->
    <canvas
      id="navbar-water-canvas"
      class="pointer-events-none absolute inset-0 z-0 h-full w-full rounded-[32px]"
      aria-hidden="true"
    ></canvas>

    <div class="relative z-10 flex items-center justify-between">
      <!-- Brand logo -->
      <a
        class="flex-none rounded-lg text-xl font-bold outline-hidden ring-zinc-500 focus-visible:ring-3 dark:ring-zinc-200 dark:focus:outline-hidden"
        href={homeUrl}
        aria-label="Brand"
      >
        <BrandLogo class="h-10 w-auto md:h-12 py-1" />
      </a>
      <!-- Collapse toggle for smaller screens -->
      <div class="ml-auto mr-5 md:hidden">
        <button
          type="button"
          class="hs-collapse-toggle flex h-8 w-8 items-center justify-center rounded-full text-sm font-bold text-neutral-800 transition duration-300 hover:bg-white/40 disabled:pointer-events-none disabled:opacity-50 dark:text-neutral-100 dark:hover:bg-white/10 dark:focus:outline-hidden"
          data-hs-collapse="#navbar-collapse-with-animation"
          aria-controls="#navbar-collapse-with-animation"
          aria-label="Toggle navigation"
        >
          <svg
            class="h-[1.25rem] w-[1.25rem] shrink-0 hs-collapse-open:hidden"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="3" x2="21" y1="6" y2="6"></line>
            <line x1="3" x2="21" y1="12" y2="12"></line>
            <line x1="3" x2="21" y1="18" y2="18"></line>
          </svg>
          <svg
            class="hidden h-[1.25rem] w-[1.25rem] shrink-0 hs-collapse-open:block"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>
      <!-- ThemeIcon component specifically for smaller screens -->
      <span class="inline-block md:hidden">
        <ThemeIcon />
      </span>
    </div>
    <!-- Contains navigation links -->
    <div
      id="navbar-collapse-with-animation"
      class="hs-collapse relative z-10 hidden grow basis-full overflow-hidden transition-all duration-300 md:block"
    >
      <!-- Navigation links container -->
      <div
        class="mt-3 flex flex-col gap-y-1 border-t border-white/40 pt-3 pb-2 dark:border-white/10 md:mt-0 md:flex-row md:items-center md:justify-end md:gap-x-4 md:gap-y-0 md:border-t-0 md:p-0 md:ps-7 lg:gap-x-7"
      >
        <!-- Navigation links and Authentication component -->
        {strings.navBarLinks.map(link => (
          <NavLink url={link.url} name={link.name} />
        ))}

        <!-- ThemeIcon component specifically for larger screens -->
        <span class="hidden md:inline-block">
          <ThemeIcon />
        </span>
      </div>
    </div>
  </nav>
</header>
<!-- Theme Appearance script to manage light/dark modes -->
<script is:inline>
  const HSThemeAppearance = {
    init() {
      const defaultTheme = "default";
      let theme = defaultTheme;
      try {
        theme = localStorage.getItem("hs_theme") || defaultTheme;
      } catch (e) {
        theme = defaultTheme;
      }

      if (document.querySelector("html").classList.contains("dark")) return;
      this.setAppearance(theme, false);
    },
    _resetStylesOnLoad() {
      const $resetStyles = document.createElement("style");
      $resetStyles.innerText = `*{transition: unset !important;}`;
      $resetStyles.setAttribute("data-hs-appearance-onload-styles", "");
      document.head.appendChild($resetStyles);
      return $resetStyles;
    },
    setAppearance(theme, saveInStore = true, dispatchEvent = true) {
      const $resetStylesEl = this._resetStylesOnLoad();

      if (saveInStore) {
        try {
          localStorage.setItem("hs_theme", theme);
        } catch (e) {}
      }

      if (theme === "auto") {
        theme = window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "default";
      }

      const html = document.querySelector("html");
      html.classList.remove("light", "dark", "default", "auto");

      const resolvedTheme = this.getOriginalAppearance();
      const themeToAdd = resolvedTheme === "auto" ? theme : resolvedTheme;
      html.classList.add(themeToAdd === "dark" ? "dark" : "default");

      setTimeout(() => {
        $resetStylesEl.remove();
      });

      if (dispatchEvent) {
        window.dispatchEvent(
          new CustomEvent("on-hs-appearance-change", { detail: theme }),
        );
      }
    },
    getAppearance() {
      let theme = this.getOriginalAppearance();
      if (theme === "auto") {
        theme = window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "default";
      }
      return theme;
    },
    getOriginalAppearance() {
      const defaultTheme = "default";
      try {
        return localStorage.getItem("hs_theme") || defaultTheme;
      } catch (e) {
        return defaultTheme;
      }
    },
  };
  HSThemeAppearance.init();

  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", () => {
      if (HSThemeAppearance.getOriginalAppearance() === "auto") {
        HSThemeAppearance.setAppearance("auto", false);
      }
    });

  window.addEventListener("load", () => {
    const $clickableThemes = document.querySelectorAll(
      "[data-hs-theme-click-value]",
    );
    const $switchableThemes = document.querySelectorAll(
      "[data-hs-theme-switch]",
    );

    $clickableThemes.forEach(($item) => {
      $item.addEventListener("click", () =>
        HSThemeAppearance.setAppearance(
          $item.getAttribute("data-hs-theme-click-value"),
          true,
          $item,
        ),
      );
    });

    $switchableThemes.forEach(($item) => {
      $item.addEventListener("change", (e) => {
        HSThemeAppearance.setAppearance(e.target.checked ? "dark" : "default");
      });

      $item.checked = HSThemeAppearance.getAppearance() === "dark";
    });

    window.addEventListener("on-hs-appearance-change", (e) => {
      $switchableThemes.forEach(($item) => {
        $item.checked = e.detail === "dark";
      });
    });
  });
</script>

<!-- Interactive Liquid Water Surface Ripple Engine -->
<script is:inline>
  (function () {
    function initNavbarWater() {
      const nav = document.querySelector(".liquid-glass-nav");
      const canvas = document.getElementById("navbar-water-canvas");
      if (!nav || !canvas) return;

      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      let width = 0;
      let height = 0;
      let dpr = window.devicePixelRatio || 1;
      let ripples = [];
      let isRunning = false;
      let lastX = 0;
      let lastY = 0;

      function resize() {
        const rect = nav.getBoundingClientRect();
        width = rect.width;
        height = rect.height;
        dpr = window.devicePixelRatio || 1;
        canvas.width = Math.floor(width * dpr);
        canvas.height = Math.floor(height * dpr);
        canvas.style.width = width + "px";
        canvas.style.height = height + "px";
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.scale(dpr, dpr);
      }

      resize();
      if (typeof ResizeObserver !== "undefined") {
        new ResizeObserver(resize).observe(nav);
      } else {
        window.addEventListener("resize", resize);
      }

      function addRipple(x, y, speed, strength) {
        ripples.push({
          x: x,
          y: y,
          radius: 2,
          maxRadius: Math.max(width, height) * 0.45,
          alpha: strength || 0.5,
          speed: speed || 2.4,
          decay: 0.962,
        });

        if (!isRunning) {
          isRunning = true;
          requestAnimationFrame(animate);
        }
      }

      function animate() {
        if (ripples.length === 0) {
          ctx.clearRect(0, 0, width, height);
          isRunning = false;
          return;
        }

        ctx.clearRect(0, 0, width, height);
        const isDark = document.documentElement.classList.contains("dark");

        for (let i = ripples.length - 1; i >= 0; i--) {
          const r = ripples[i];
          r.radius += r.speed;
          r.alpha *= r.decay;

          if (r.alpha < 0.012 || r.radius > r.maxRadius) {
            ripples.splice(i, 1);
            continue;
          }

          const crestAlpha = Math.min(1, r.alpha * 1.25);

          // Liquid ripple wave crest
          ctx.save();
          ctx.beginPath();
          ctx.arc(r.x, r.y, r.radius, 0, Math.PI * 2);
          ctx.strokeStyle = isDark
            ? `rgba(186, 230, 253, ${crestAlpha * 0.4})`
            : `rgba(255, 255, 255, ${crestAlpha * 0.8})`;
          ctx.lineWidth = Math.max(0.8, 3.2 * (1 - r.radius / r.maxRadius));
          ctx.stroke();

          // Refraction secondary ring (subtle water shimmer)
          if (r.radius > 6) {
            ctx.beginPath();
            ctx.arc(r.x, r.y, Math.max(1, r.radius - 4.5), 0, Math.PI * 2);
            ctx.strokeStyle = isDark
              ? `rgba(147, 197, 253, ${crestAlpha * 0.18})`
              : `rgba(186, 230, 253, ${crestAlpha * 0.35})`;
            ctx.lineWidth = 1.2;
            ctx.stroke();
          }
          ctx.restore();
        }

        requestAnimationFrame(animate);
      }

      nav.addEventListener("mousemove", (e) => {
        const rect = nav.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const dist = Math.hypot(x - lastX, y - lastY);
        if (dist > 14) {
          addRipple(x, y, 2.2, 0.45);
          lastX = x;
          lastY = y;
        }
      });

      nav.addEventListener("mouseenter", (e) => {
        const rect = nav.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        addRipple(x, y, 2.8, 0.65);
        lastX = x;
        lastY = y;
      });

      nav.addEventListener(
        "touchmove",
        (e) => {
          if (e.touches && e.touches.length > 0) {
            const rect = nav.getBoundingClientRect();
            const x = e.touches[0].clientX - rect.left;
            const y = e.touches[0].clientY - rect.top;
            const dist = Math.hypot(x - lastX, y - lastY);
            if (dist > 16) {
              addRipple(x, y, 2.0, 0.4);
              lastX = x;
              lastY = y;
            }
          }
        },
        { passive: true },
      );
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initNavbarWater);
    } else {
      initNavbarWater();
    }
  })();
</script>
