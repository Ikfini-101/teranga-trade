---
// Import necessary dependencies
import MainLayout from "@/layouts/MainLayout.astro";
import { SITE } from "@data/constants";

const pageTitle = `Mentions Légales & Confidentialité | ${SITE.title}`;
const metaDescription =
  "Mentions légales, informations juridiques, hébergement Cloudflare et politique de protection des données personnelles de Teranga Trade And Logistics.";
const ogTitle = `Mentions Légales | ${SITE.title}`;
---

<MainLayout
  title={pageTitle}
  lang="fr"
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE.url}/mentions-legales`,
    url: `${SITE.url}/mentions-legales`,
    name: pageTitle,
    description: metaDescription,
    isPartOf: {
      "@type": "WebSite",
      url: SITE.url,
      name: SITE.title,
    },
    inLanguage: "fr",
  }}
>
  <div class="mx-auto max-w-[85rem] px-4 py-8 sm:px-6 lg:px-8 lg:py-12 relative z-10">
    <!-- En-tête de la page -->
    <header class="mb-8 sm:mb-12 text-center max-w-3xl mx-auto">
      <h1 class="text-3xl font-extrabold tracking-tight text-neutral-900 sm:text-4xl md:text-5xl dark:text-neutral-100">
        Mentions Légales
      </h1>
      <p class="mt-3 text-base sm:text-lg text-neutral-700 dark:text-neutral-300">
        Informations juridiques, gouvernance, hébergement et politique de protection des données personnelles de Teranga Trade And Logistics.
      </p>
      <div class="mt-4 inline-flex items-center gap-2 rounded-full border border-neutral-200 bg-white/80 px-4 py-1.5 text-xs font-medium text-neutral-600 shadow-xs dark:border-neutral-700 dark:bg-neutral-800/80 dark:text-neutral-300">
        <span>Dernière mise à jour : Octobre 2026</span>
      </div>
    </header>

    <!-- Conteneur principal haute lisibilité WCAG -->
    <div class="space-y-8 max-w-4xl mx-auto">

      <!-- 1. IDENTITÉ ET ÉDITEUR -->
      <section class="rounded-2xl border border-neutral-200/80 bg-white/95 p-6 shadow-md backdrop-blur-md sm:p-10 dark:border-neutral-700/80 dark:bg-neutral-900/95">
        <h2 class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100 flex items-center gap-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-yellow-500/15 text-yellow-600 font-extrabold text-sm dark:bg-yellow-400/20 dark:text-yellow-400">01</span>
          Éditeur du Site
        </h2>

        <p class="mt-4 text-base text-neutral-700 dark:text-neutral-300 leading-relaxed">
          Le site internet <strong class="text-neutral-900 dark:text-neutral-100">teranga-trade-logistics.com</strong> (ainsi que son miroir <strong class="text-neutral-900 dark:text-neutral-100">teranga-trade.pages.dev</strong>) est édité conjointement par les entités du groupe <strong>Teranga Trade And Logistics</strong> :
        </p>

        <div class="mt-6 grid gap-6 sm:grid-cols-2">
          <!-- Entité Europe -->
          <div class="rounded-xl border border-neutral-200 bg-neutral-50/80 p-5 dark:border-neutral-700 dark:bg-neutral-800/60">
            <div class="text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">Centrale d'achat européenne</div>
            <h3 class="mt-2 text-lg font-bold text-neutral-900 dark:text-neutral-100">Teranga Trade And Logistics — Europe</h3>
            <ul class="mt-3 space-y-1.5 text-sm text-neutral-700 dark:text-neutral-300">
              <li><strong>Forme juridique :</strong> SASU (Société par Actions Simplifiée Unipersonnelle)</li>
              <li><strong>Siège social :</strong> 112 rue du Maréchal Joffre, 76600 Le Havre, France</li>
              <li><strong>Capital social :</strong> <span class="text-xs text-neutral-500 dark:text-neutral-400">[En cours de dépôt]</span></li>
              <li><strong>RCS / SIREN :</strong> <span class="rounded bg-yellow-100 px-1.5 py-0.5 text-xs font-medium text-yellow-800 dark:bg-yellow-900/40 dark:text-yellow-300">RCS Le Havre — Immatriculation en cours d'attribution</span></li>
              <li><strong>TVA Intracommunautaire :</strong> <span class="text-xs text-neutral-500 dark:text-neutral-400">[En cours d'attribution]</span></li>
            </ul>
          </div>

          <!-- Entité Afrique -->
          <div class="rounded-xl border border-neutral-200 bg-neutral-50/80 p-5 dark:border-neutral-700 dark:bg-neutral-800/60">
            <div class="text-xs font-bold uppercase tracking-wider text-orange-600 dark:text-orange-400">Implantation locale & Logistique</div>
            <h3 class="mt-2 text-lg font-bold text-neutral-900 dark:text-neutral-100">Teranga Trade And Logistics — Africa</h3>
            <ul class="mt-3 space-y-1.5 text-sm text-neutral-700 dark:text-neutral-300">
              <li><strong>Forme juridique :</strong> SARL (Société à Responsabilité Limitée)</li>
              <li><strong>Siège social :</strong> Dakar, Sénégal <span class="text-xs text-neutral-500 dark:text-neutral-400">[Adresse en cours d'enregistrement]</span></li>
              <li><strong>NINEA / RCCM :</strong> <span class="rounded bg-yellow-100 px-1.5 py-0.5 text-xs font-medium text-yellow-800 dark:bg-yellow-900/40 dark:text-yellow-300">Immatriculation en cours d'attribution</span></li>
              <li><strong>Opérations :</strong> Dédouanement, manutention portuaire et remise documentaire</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- 2. DIRECTEUR DE LA PUBLICATION -->
      <section class="rounded-2xl border border-neutral-200/80 bg-white/95 p-6 shadow-md backdrop-blur-md sm:p-10 dark:border-neutral-700/80 dark:bg-neutral-900/95">
        <h2 class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100 flex items-center gap-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-yellow-500/15 text-yellow-600 font-extrabold text-sm dark:bg-yellow-400/20 dark:text-yellow-400">02</span>
          Direction de la Publication
        </h2>
        <div class="mt-4 text-base text-neutral-700 dark:text-neutral-300 space-y-2 leading-relaxed">
          <p>
            <strong>Directeur de la publication :</strong> M. <strong class="text-neutral-900 dark:text-neutral-100">Aliou CISSE</strong>, Président-Fondateur de Teranga Trade And Logistics.
          </p>
          <p>
            <strong>Contact officiel :</strong> Les demandes de contact, d'informations ou d'exercice de droits peuvent être adressées via notre <a href="/contact" class="font-semibold text-yellow-600 hover:underline dark:text-yellow-400">formulaire de contact sécurisé</a> ou par courrier électronique à l'adresse suivante : <a href="mailto:contact@teranga-trade-logistics.com" class="font-semibold text-neutral-900 hover:underline dark:text-neutral-100">contact@teranga-trade-logistics.com</a>.
          </p>
        </div>
      </section>

      <!-- 3. HÉBERGEUR -->
      <section class="rounded-2xl border border-neutral-200/80 bg-white/95 p-6 shadow-md backdrop-blur-md sm:p-10 dark:border-neutral-700/80 dark:bg-neutral-900/95">
        <h2 class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100 flex items-center gap-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-yellow-500/15 text-yellow-600 font-extrabold text-sm dark:bg-yellow-400/20 dark:text-yellow-400">03</span>
          Hébergement du Site
        </h2>
        <div class="mt-4 text-base text-neutral-700 dark:text-neutral-300 leading-relaxed space-y-3">
          <p>
            Le site est hébergé sur l'infrastructure mondiale de pointe de :
          </p>
          <div class="rounded-xl border border-neutral-200 bg-neutral-50/80 p-5 dark:border-neutral-700 dark:bg-neutral-800/60">
            <h3 class="font-bold text-neutral-900 dark:text-neutral-100">Cloudflare, Inc.</h3>
            <p class="mt-1 text-sm text-neutral-700 dark:text-neutral-300">101 Townsend St, San Francisco, CA 94107, États-Unis</p>
            <p class="mt-1 text-sm text-neutral-700 dark:text-neutral-300">Site web officiel : <a href="https://www.cloudflare.com" target="_blank" rel="noopener noreferrer" class="text-yellow-600 hover:underline dark:text-yellow-400">www.cloudflare.com</a></p>
            <p class="mt-1 text-sm text-neutral-700 dark:text-neutral-300">Téléphone : +1 (650) 319-8930</p>
          </div>
          <p class="text-sm text-neutral-600 dark:text-neutral-400">
            L'infrastructure bénéficie d'un réseau de distribution de contenu (CDN) sécurisé avec chiffrement SSL/TLS (HTTPS 256 bits), assurant la haute disponibilité et la protection des échanges.
          </p>
        </div>
      </section>

      <!-- 4. ACTIVITÉS ET CONDITIONS COMMERCIALES -->
      <section class="rounded-2xl border border-neutral-200/80 bg-white/95 p-6 shadow-md backdrop-blur-md sm:p-10 dark:border-neutral-700/80 dark:bg-neutral-900/95">
        <h2 class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100 flex items-center gap-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-yellow-500/15 text-yellow-600 font-extrabold text-sm dark:bg-yellow-400/20 dark:text-yellow-400">04</span>
          Nature des Activités & Régime Commercial
        </h2>
        <div class="mt-4 text-base text-neutral-700 dark:text-neutral-300 leading-relaxed space-y-3">
          <p>
            Teranga Trade And Logistics exerce une activité de <strong>centrale d'achat européenne, de négoce international et de logistique maritime</strong> dédiée aux professionnels d'Afrique de l'Ouest.
          </p>
          <ul class="list-disc pl-6 space-y-2">
            <li><strong>Disponibilité des matériels :</strong> Les matériels et véhicules présentés sur ce site (autocars, engins BTP, matériels agricoles) sont proposés <em>sur commande et sous réserve de disponibilité réelle</em> auprès de nos réseaux partenaires en Europe au moment de la signature du devis et du bon de commande.</li>
            <li><strong>Incoterms® et transport :</strong> Les opérations d'expédition maritime sont conduites selon les règles officielles Incoterms® de la Chambre de Commerce Internationale (ICC), notamment sous l'Incoterm <strong>CFR (Coût et Fret)</strong> au port convenu, sauf stipulation contraire convenue expressément par contrat écrit.</li>
            <li><strong>Devis et contractualisation :</strong> Toute commande fait l'objet d'un devis préalable formel détaillant les spécifications techniques, les modalités de paiement sécurisées et le calendrier d'expédition maritime.</li>
          </ul>
        </div>
      </section>

      <!-- 5. PROPRIÉTÉ INTELLECTUELLE -->
      <section class="rounded-2xl border border-neutral-200/80 bg-white/95 p-6 shadow-md backdrop-blur-md sm:p-10 dark:border-neutral-700/80 dark:bg-neutral-900/95">
        <h2 class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100 flex items-center gap-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-yellow-500/15 text-yellow-600 font-extrabold text-sm dark:bg-yellow-400/20 dark:text-yellow-400">05</span>
          Propriété Intellectuelle
        </h2>
        <div class="mt-4 text-base text-neutral-700 dark:text-neutral-300 leading-relaxed space-y-3">
          <p>
            L'ensemble des éléments constituant le site (notamment la marque <strong>Teranga Trade And Logistics</strong>, son logo, sa charte graphique, les textes, photographies d'engins et de véhicules, schémas, icônes, ainsi que le code source) est protégé par les lois françaises et internationales relatives à la propriété intellectuelle.
          </p>
          <p>
            Toute reproduction, représentation, diffusion, adaptation ou exploitation, totale ou partielle, de l'un quelconque de ces éléments, par quelque procédé que ce soit, sans l'autorisation expresse et écrite préalable de Teranga Trade And Logistics est strictement interdite et constituerait une contrefaçon sanctionnée par le Code de la propriété intellectuelle.
          </p>
        </div>
      </section>

      <!-- 6. DONNÉES PERSONNELLES ET RGPD -->
      <section id="donnees-personnelles" class="scroll-mt-24 rounded-2xl border border-neutral-200/80 bg-white/95 p-6 shadow-md backdrop-blur-md sm:p-10 dark:border-neutral-700/80 dark:bg-neutral-900/95">
        <h2 class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100 flex items-center gap-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-yellow-500/15 text-yellow-600 font-extrabold text-sm dark:bg-yellow-400/20 dark:text-yellow-400">06</span>
          Protection des Données Personnelles (RGPD)
        </h2>
        <div class="mt-4 text-base text-neutral-700 dark:text-neutral-300 leading-relaxed space-y-4">
          <p>
            Teranga Trade And Logistics s'engage à respecter la vie privée des utilisateurs et à traiter leurs données à caractère personnel dans le strict respect du Règlement Général sur la Protection des Données (RGPD - Règlement UE 2016/679) et des lois sénégalaises applicables (Loi n° 2008-12 relative à la protection des données à caractère personnel).
          </p>

          <div class="rounded-xl border border-neutral-200 bg-neutral-50/80 p-5 dark:border-neutral-700 dark:bg-neutral-800/60 space-y-3">
            <h3 class="font-bold text-neutral-900 dark:text-neutral-100">Principes régissant la collecte et le traitement :</h3>
            <ul class="list-disc pl-5 space-y-1.5 text-sm">
              <li><strong>Finalité du traitement :</strong> Les données collectées via notre formulaire de contact (nom, prénom, e-mail, téléphone, société, cahier des charges) sont strictement destinées au traitement commercial de votre demande d'acquisition de matériel et à l'établissement de propositions tarifaires.</li>
              <li><strong>Base juridique :</strong> Exécution de mesures précontractuelles ou contractuelles prises à la demande expresse de l'utilisateur (Art. 6.1.b du RGPD).</li>
              <li><strong>Conservation des données :</strong> Les coordonnées des prospects sont conservées pendant une durée maximale de 3 ans à compter du dernier contact actif. Les données contractuelles clients sont archivées conformément aux durées légales comptables (10 ans).</li>
              <li><strong>Non-cession :</strong> Aucune donnée personnelle n'est vendue, louée, commercialisée ou cédée à des tiers à des fins publicitaires.</li>
            </ul>
          </div>

          <p>
            <strong>Vos droits :</strong> Conformément à la réglementation, vous bénéficiez à tout moment d'un droit d'accès, de rectification, d'effacement (« droit à l'oubli »), de limitation du traitement, de portabilité et d'opposition au traitement de vos données.
          </p>
          <p>
            Pour exercer ces droits, vous pouvez contacter notre délégué par simple message adressé à : <a href="mailto:contact@teranga-trade-logistics.com" class="font-semibold text-yellow-600 hover:underline dark:text-yellow-400">contact@teranga-trade-logistics.com</a>, accompagné d'un justificatif d'identité si requis.
          </p>
          <p class="text-sm text-neutral-600 dark:text-neutral-400">
            En cas de contestation non résolue, vous avez le droit d'introduire une réclamation auprès de l'autorité compétente : la CNIL en France (<a href="https://www.cnil.fr" target="_blank" rel="noopener noreferrer" class="underline">www.cnil.fr</a>) ou la CDP au Sénégal (<a href="https://www.cdp.sn" target="_blank" rel="noopener noreferrer" class="underline">www.cdp.sn</a>).
          </p>
        </div>
      </section>

      <!-- 7. GESTION DES COOKIES -->
      <section class="rounded-2xl border border-neutral-200/80 bg-white/95 p-6 shadow-md backdrop-blur-md sm:p-10 dark:border-neutral-700/80 dark:bg-neutral-900/95">
        <h2 class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100 flex items-center gap-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-yellow-500/15 text-yellow-600 font-extrabold text-sm dark:bg-yellow-400/20 dark:text-yellow-400">07</span>
          Politique Relative aux Cookies
        </h2>
        <div class="mt-4 text-base text-neutral-700 dark:text-neutral-300 leading-relaxed space-y-3">
          <p>
            Le site de Teranga Trade And Logistics privilégie la sobriété numérique et le respect strict de votre vie privée :
          </p>
          <ul class="list-disc pl-6 space-y-2">
            <li><strong>Aucun cookie publicitaire ou de profilage tiers</strong> n'est déposé sur votre terminal lors de votre navigation.</li>
            <li><strong>Cookies techniques strictement nécessaires :</strong> Seul le stockage local (<code>localStorage</code>) est employé de façon sécurisée afin de retenir votre choix d'affichage ergonomique (mode clair ou mode sombre).</li>
          </ul>
        </div>
      </section>

      <!-- 8. DROIT APPLICABLE -->
      <section class="rounded-2xl border border-neutral-200/80 bg-white/95 p-6 shadow-md backdrop-blur-md sm:p-10 dark:border-neutral-700/80 dark:bg-neutral-900/95">
        <h2 class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100 flex items-center gap-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-yellow-500/15 text-yellow-600 font-extrabold text-sm dark:bg-yellow-400/20 dark:text-yellow-400">08</span>
          Droit Applicable & Juridiction
        </h2>
        <p class="mt-4 text-base text-neutral-700 dark:text-neutral-300 leading-relaxed">
          Les présentes mentions légales sont régies par le droit français et les conventions internationales régissant le commerce maritime et la vente internationale de marchandises. Tout différend relatif à l'interprétation ou à l'exécution des présentes sera soumis aux juridictions matériellement et territorialement compétentes.
        </p>
      </section>

    </div>
  </div>
</MainLayout>
