---
// Import the necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import ContactSection from "@components/sections/fr/ContactSection_fr.astro";
import { SITE } from "@data/constants";

const pageTitle: string = `Contactez notre Centrale d'Achat | ${SITE.title}`;
const metaDescription =
  "Contactez la centrale d'achat Teranga Trade And Logistics au Havre (France) et notre filiale à Dakar (Sénégal) pour vos besoins en transport, BTP et agriculture.";
const ogTitle = `Contact | ${SITE.title}`;
---

<MainLayout
  title={pageTitle}
  lang="fr"
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "@id": `${SITE.url}/contact`,
    url: `${SITE.url}/contact`,
    name: pageTitle,
    description: metaDescription,
    isPartOf: {
      "@type": "WebSite",
      url: SITE.url,
      name: SITE.title,
      description: SITE.description,
    },
    inLanguage: "fr",
  }}
>
  <ContactSection />
</MainLayout>
